{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-aie-final/types/**/*.ts",
    ".next-biometric-practice/types/**/*.ts",
    ".next-certificate-management/types/**/*.ts",
    ".next-challan-final-2/types/**/*.ts",
    ".next-challan-last/types/**/*.ts",
    ".next-challan-verification/types/**/*.ts",
    ".next-design-preview/types/**/*.ts",
    ".next-enterprise-demo/types/**/*.ts",
    ".next-examination-verify/types/**/*.ts",
    ".next-finance-workflow/types/**/*.ts",
    ".next-launch-demo/types/**/*.ts",
    ".next-ui-responsive/types/**/*.ts",
    ".next-usability-build/types/**/*.ts",
    ".next-verification/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-aie-audit/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
