# Copy to .env and provide independent, random server secrets (at least 32 characters).
MONGODB_URI=mongodb://127.0.0.1:27017/acadivo_school_crm
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=5000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
# Manual fee review uses MongoDB transactions: use a replica set or MongoDB Atlas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# Optional first-time platform account provisioning; no default password.
SUPER_ADMIN_EMAIL=superadmin@acadivo.com
SUPER_ADMIN_INITIAL_PASSWORD=
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=
# Conversational assistant (server only)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# AES-256-GCM device credential encryption: random 32-byte key encoded as 64 hex characters.
BIOMETRIC_ENCRYPTION_KEY=
